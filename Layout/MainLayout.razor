@inherits LayoutComponentBase
@inject GameState G
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable
@if (ready)
{
<div class="shell">
    <aside class="side">
        <div class="brand">FLOW<span>STATE</span><small>TASK MANAGER</small></div>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All"><i>▦</i>Dashboard</NavLink>
            <NavLink href="new"><i>＋</i>New Mission</NavLink>
            <NavLink href="shop"><i>◈</i>Shop</NavLink>
            <NavLink href="inventory"><i>▤</i>Inventory</NavLink>
            <NavLink href="missions"><i>≡</i>Missions</NavLink>
        </nav>
        @if (Auth.Current is { } u)
        {
            <div class="user"><span class="lbl">OPERATOR</span><b>@u.Username</b>
                <button type="button" class="btn ghost sm" @onclick="SignOut">SIGN OUT</button></div>
        }
    </aside>
    <main class="main">@Body</main>
    <nav class="bottom">
        <NavLink href="" Match="NavLinkMatch.All"><i>▦</i>Dashboard</NavLink>
        <NavLink href="new"><i>＋</i>New</NavLink>
        <NavLink href="shop"><i>◈</i>Shop</NavLink>
        <NavLink href="inventory"><i>▤</i>Inventory</NavLink>
        <NavLink href="missions"><i>≡</i>Missions</NavLink>
    </nav>
</div>
}
@code {
    bool ready;

    protected override async Task OnInitializedAsync()
    {
        G.Changed += Refresh;
        Auth.Changed += Refresh;
        await Auth.InitAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("login", replace: true); return; }
        ready = true;
    }

    async Task SignOut()
    {
        await Auth.SignOutAsync();
        ready = false;
        Nav.NavigateTo("login", replace: true);
    }

    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() { G.Changed -= Refresh; Auth.Changed -= Refresh; }
}
