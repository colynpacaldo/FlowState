@page "/missions"
@inject GameState G
<div class="max-w-[820px] px-10 py-8">
    <h1 class="@Ui.H1">MISSION MANAGER</h1><p class="text-muted">Manage your routines. Archive unused missions instead of deleting.</p>
    <h3 class="@Ui.Sect">ACTIVE — @G.Missions.Count</h3>
    @foreach (var m in G.Missions)
    {
        <div class="@Ui.Mrow(m.Cat)"><span class="@Ui.ChipPlain">@(m.Heavy ? "HEAVY" : "DAILY")</span>
            <span class="@Ui.CatText(m.Cat)">@m.Cat.ToString().ToUpper()</span><span class="flex-1">@m.Name</span>
            <span class="@Ui.St"><em class="@Ui.Bolt">⚡</em> @m.Cost</span><span class="@Ui.St">+@m.Exp EXP</span>
            <button class="@Ui.GhostSm" @onclick="() => G.Remove(m)">Archive</button>
            <button class="@Ui.GhostSm" @onclick="() => G.Remove(m)">Delete</button></div>
    }
</div>
