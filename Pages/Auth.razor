@page "/login"
@page "/register"
@layout BlankLayout
@using System.Globalization
@inject NavigationManager Nav
@inject AuthService Accounts
@inject GameState G
@implements IDisposable
<PageTitle>@(Reg ? "Create account" : "Sign in") · FlowState</PageTitle>
<div class="grid min-h-screen grid-cols-2 max-compact:grid-cols-1">
    <section class="flex flex-col items-center justify-center gap-4 border-r border-line bg-surface p-8 max-compact:hidden">
        <h1 class="font-head text-[4rem] font-bold tracking-[.12em]">FLOW<span class="text-gold">STATE</span></h1>
        <p class="text-[1.1rem] text-muted italic">Spend energy. Earn your time back.</p>

        <svg class="mt-4 mb-[.3rem] h-auto w-[300px] max-w-full" viewBox="0 0 300 240" role="img" aria-hidden="true">
            <polygon points="@Hex(98)" fill="none" class="stroke-line" stroke-width="1.2" />
            @if (Reg)
            {
                <polygon points="@Hex(76)" fill="none" class="stroke-gold-dim" stroke-width="1.6" />
                <circle cx="150" cy="105" r="36" fill="none" class="stroke-line" stroke-width="1.2" />
                @LevelBadge
            }
            else
            {
                <polygon points="@Hex(76)" fill="none" class="stroke-gold-dim" stroke-width="1.6" />
                <polygon points="@Hex(46)" fill="none" class="stroke-gold-dim" stroke-width="1.2" />
                <g class="stroke-gold-dim" stroke-width="1.2">
                    <line x1="150" y1="105" x2="150" y2="66" />
                    <line x1="150" y1="105" x2="184" y2="125" />
                    <line x1="150" y1="105" x2="116" y2="125" />
                </g>
                <circle cx="150" cy="105" r="9" class="fill-surface stroke-gold" stroke-width="2.5" />
                <circle cx="150" cy="105" r="2.5" class="fill-gold" />
                <g class="stroke-line" stroke-width="1.2">
                    <line x1="100" y1="216" x2="200" y2="216" />
                    <line x1="112" y1="212" x2="112" y2="220" /><line x1="125" y1="212" x2="125" y2="220" />
                    <line x1="138" y1="212" x2="138" y2="220" /><line x1="162" y1="212" x2="162" y2="220" />
                    <line x1="175" y1="212" x2="175" y2="220" /><line x1="188" y1="212" x2="188" y2="220" />
                    <line x1="20" y1="224" x2="40" y2="224" /><line x1="30" y1="214" x2="30" y2="234" />
                    <line x1="260" y1="224" x2="280" y2="224" /><line x1="270" y1="214" x2="270" y2="234" />
                </g>
                <line x1="128" y1="216" x2="176" y2="216" class="stroke-gold" stroke-width="2.5" />
            }
        </svg>

        <div class="bg-field @(Reg ? "h-[10px] w-[200px]" : "h-[7px] w-[175px]")"><i class="block h-full @(Reg ? "bg-segments" : "bg-gold")" style="width:@(Reg ? 100 : 65)%"></i></div>
        <p class="font-mono text-[.72rem] tracking-[.1em] text-muted">@(Reg ? "240 / 240 · FULL" : "LVL 1 · 0 / 100 EXP")</p>
        @if (Reg) { <p class="mt-6 border border-line px-[1.4rem] py-[.9rem] text-muted">You'll start at <b class="text-gold">Level 1</b> with full energy — 240/240.</p> }
    </section>

    <section class="flex items-center justify-center bg-canvas p-8">
        <form class="w-full max-w-[480px]" @onsubmit="Submit" novalidate>
            <h2 class="font-head text-[2.3rem] font-bold tracking-[.1em]">@(Reg ? "CREATE ACCOUNT" : "SIGN IN")</h2>
            <p class="mt-2 mb-4 text-muted">@(Reg ? "Begin your mission log." : "Welcome back, Operator.")</p>

            @if (Reg)
            {
                <label class="@Ui.Label">USERNAME
                    <input class="@Ui.Input" @bind="username" @bind:event="oninput" @onblur='() => Touch("u")' placeholder="commander_rex"
                           autocomplete="username" maxlength="20" aria-invalid="@(Inv(Err("u", AuthRules.Username(username)) is not null))" />
                    @if (Err("u", AuthRules.Username(username)) is string mu) { <small class="@Ui.Err">@mu</small> }
                </label>
            }

            <label class="@Ui.Label">EMAIL
                <input class="@Ui.Input" type="email" @bind="email" @bind:event="oninput" @onblur='() => Touch("e")' placeholder="your@email.com"
                       autocomplete="email" aria-invalid="@(Inv(Reg && Err("e", AuthRules.Email(email)) is not null))" />
                @if (Reg && Err("e", AuthRules.Email(email)) is string me) { <small class="@Ui.Err">@me</small> }
            </label>

            <label class="@Ui.Label">PASSWORD
                <span class="relative block">
                    <input class="@Ui.Input" type="@(show ? "text" : "password")" @bind="password" @bind:event="oninput" @onblur='() => Touch("p")'
                           autocomplete="@(Reg ? "new-password" : "current-password")"
                           aria-invalid="@(Inv(Reg && Err("p", AuthRules.Password(password)) is not null))" />
                    <button type="button" class="@Ui.Eye" @onclick="() => show = !show"
                            aria-label="@(show ? "Hide password" : "Show password")" aria-pressed="@(show ? "true" : "false")">
                        @if (show)
                        {
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.9 5.2A10.5 10.5 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6A16.6 16.6 0 0 0 2 12s3.6 7 10 7a9.8 9.8 0 0 0 5.4-1.6" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" /><path d="m3 3 18 18" /></svg>
                        }
                    </button>
                </span>
                @if (Reg)
                {
                    @if (Err("p", AuthRules.Password(password)) is string mp) { <small class="@Ui.Err">@mp</small> }
                    else { <small class="@Ui.Hint">At least @AuthRules.MinPassword characters.</small> }
                }
            </label>

            @if (Reg)
            {
                <label class="@Ui.Label">CONFIRM PASSWORD
                    <input class="@Ui.Input" type="password" @bind="confirm" @bind:event="oninput" @onblur='() => Touch("c")'
                           autocomplete="new-password" aria-invalid="@(Inv(Err("c", AuthRules.Confirm(password, confirm)) is not null))" />
                    @if (Err("c", AuthRules.Confirm(password, confirm)) is string mc) { <small class="@Ui.Err">@mc</small> }
                </label>
            }

            @if (error is not null) { <p class="mt-4 border-l-2 border-danger bg-danger/12 px-4 py-[.7rem] text-danger-soft" role="alert">@error</p> }

            <button type="submit" class="@Ui.BtnWide" disabled="@(!Valid || busy)">
                @(busy ? "PLEASE WAIT…" : Reg ? "CREATE ACCOUNT" : "SIGN IN")
            </button>

            @if (!Reg)
            {
                <p class="mt-[.9rem] text-center"><button type="button" class="@Ui.LinkBtn" @onclick="() => forgot = !forgot">Forgot password?</button></p>
                @if (forgot)
                {
                    <p class="mt-[.9rem] text-center text-[.78rem] text-muted" role="status">Password reset isn't available yet — accounts are stored only in this browser.</p>
                }
                <p class="mt-[.9rem] text-center text-muted">New here? <a class="text-gold" href="register">Create an account</a></p>
            }
            else
            {
                <p class="mt-[.9rem] text-center text-muted">Already have an account? <a class="text-gold" href="login">Sign in</a></p>
            }
        </form>
    </section>
</div>
@code {
    string username = "", email = "", password = "", confirm = "";
    string? error;
    bool show, busy, forgot;
    readonly HashSet<string> touched = new();

    bool Reg => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/register", StringComparison.OrdinalIgnoreCase);

    bool Valid => Reg
        ? AuthRules.Username(username) is null && AuthRules.Email(email) is null
          && AuthRules.Password(password) is null && AuthRules.Confirm(password, confirm) is null
        : AuthRules.Email(email) is null && password.Length > 0;

    // Razor reserves the <text> tag, so SVG <text> elements are emitted as raw markup.
    static readonly MarkupString LevelBadge = new(
        """<text x="150" y="118" text-anchor="middle" class="fill-gold font-head text-[40px] font-bold">1</text>""" +
        """<text x="150" y="134" text-anchor="middle" class="fill-muted font-body text-[10px] font-medium tracking-[.1em]">LVL</text>""");

    static string? Inv(bool invalid) => invalid ? "true" : null;
    void Touch(string k) => touched.Add(k);
    string? Err(string k, string? err) => touched.Contains(k) ? err : null;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await Accounts.InitAsync();
        if (Accounts.IsSignedIn) Nav.NavigateTo("", replace: true);
    }

    // /login and /register share this component instance, so clear the form when switching.
    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        username = email = password = confirm = "";
        error = null; show = forgot = false; touched.Clear();
        InvokeAsync(StateHasChanged);
    }

    async Task Submit()
    {
        touched.UnionWith(new[] { "u", "e", "p", "c" });
        if (busy || !Valid) return;
        busy = true; error = null;
        try
        {
            var result = Reg
                ? await Accounts.RegisterAsync(username, email, password, confirm)
                : await Accounts.SignInAsync(email, password);
            if (result.Ok)
            {
                if (Reg) G.StartFresh();
                Nav.NavigateTo("");
            }
            else error = result.Error;
        }
        finally { busy = false; }
    }

    static string Hex(double r, double cx = 150, double cy = 105) => string.Join(" ",
        Enumerable.Range(0, 6).Select(i =>
        {
            var a = Math.PI / 180 * (60 * i - 90);
            return string.Create(CultureInfo.InvariantCulture, $"{cx + r * Math.Cos(a):0.##},{cy + r * Math.Sin(a):0.##}");
        }));

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
