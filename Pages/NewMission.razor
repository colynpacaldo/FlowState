@page "/new"
@inject GameState G
@inject NavigationManager Nav
<div class="max-w-[1100px] px-10 py-8">
    <div class="flex items-center gap-[.8rem]"><a class="@Ui.GhostSm" href="">← Back</a><div><h1 class="@Ui.H1">NEW MISSION</h1><p class="text-muted">Define your next objective.</p></div></div>
    <div class="mt-6 grid grid-cols-[1.4fr_1fr] gap-10 max-form:grid-cols-1">
        <div>
            <label class="@Ui.Label">MISSION NAME<input class="@Ui.Input" @bind="name" @bind:event="oninput" placeholder="Describe the task clearly..." /></label>
            <span class="@Ui.Lbl">CATEGORY</span>
            <div class="mt-[.6rem] mb-[1.4rem] grid grid-cols-3 gap-[.6rem]">@foreach (var c in Enum.GetValues<Cat>()) { var cc = c;
                <button class="@Ui.OptCat(cc, cat == cc)" @onclick="() => cat = cc">@cc.ToString().ToUpper()</button> }</div>
            <span class="@Ui.Lbl">MISSION TYPE</span>
            <div class="mt-[.6rem] mb-2 grid grid-cols-2 gap-[.6rem]">
                <button class="@Ui.OptGold(!heavy)" @onclick="() => heavy = false">DAILY MISSION</button>
                <button class="@Ui.OptGold(heavy)" @onclick="() => heavy = true">HEAVY QUEST</button></div>
            <p class="text-[.78rem] text-muted">@(heavy ? "One-off big objectives. Higher cost, higher reward." : "Recurring daily tasks. Lower cost, lower reward.")</p>
            <div class="flex items-center justify-between"><span class="@Ui.Lbl">ENERGY COST</span><b class="text-gold"><em class="@Ui.Bolt">⚡</em> @cost</b></div>
            <div class="my-[.6rem] grid grid-cols-8 gap-[.4rem]">@for (var v = 10; v <= 80; v += 10) { var x = v; <button class="@Ui.Cost(cost == x)" @onclick="() => cost = x">@x</button> }</div>
            <p class="text-[.78rem] text-muted">Higher cost = more effort = greater reward.</p>
            <button class="@Ui.BtnWide" disabled="@(string.IsNullOrWhiteSpace(name))" @onclick="Create">CREATE MISSION</button>
        </div>
        <div>
            <span class="@Ui.Lbl">PREVIEW</span>
            <div class="@Ui.Mrow(cat)"><span class="@Ui.Chip(cat)">@cat.ToString().ToUpper()</span>
                <span class="flex-1"><i>@(string.IsNullOrWhiteSpace(name) ? "Mission name..." : name)</i></span>
                <span class="@Ui.St"><em class="@Ui.Bolt">⚡</em> @cost</span><span class="@Ui.St">+@Prev.Exp EXP</span><span class="@Ui.BtnSm">CLAIM</span></div>
            <div class="@Ui.Card"><span class="@Ui.Lbl">PROJECTED REWARDS</span>
                <div class="flex items-center justify-between"><div><small class="text-muted">EXP</small><b class="@Ui.Q">+@Prev.Exp</b></div>
                <div><small class="text-muted">Gold</small><b class="@Ui.Q">+◈@Prev.Gold</b></div>
                <div><small class="text-muted">Energy Cost</small><b class="@Ui.Q text-gold">- <em class="@Ui.Bolt">⚡</em> @cost</b></div></div></div>
        </div>
    </div>
</div>
@code {
    string name = ""; Cat cat; bool heavy; int cost = 30;
    Mission Prev => new() { Cost = cost, Heavy = heavy };
    void Create() { G.Add(new Mission { Name = name.Trim(), Cat = cat, Heavy = heavy, Cost = cost }); Nav.NavigateTo(""); }
}
